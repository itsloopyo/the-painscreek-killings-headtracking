<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <AssemblyName>PainscreekHeadTracking</AssemblyName>
    <RootNamespace>PainscreekHeadTracking</RootNamespace>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <OutputType>Library</OutputType>
    <Authors>itsloopyo</Authors>
    <Company>itsloopyo</Company>
    <Copyright>Copyright (c) 2026 itsloopyo</Copyright>
    <Description>Head tracking mod for The Painscreek Killings using CameraUnlock.Core</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <!-- CameraUnlock shared library -->
  <ItemGroup>
    <ProjectReference Include="..\..\cameraunlock-core\csharp\src\CameraUnlock.Core\CameraUnlock.Core.csproj" />
    <ProjectReference Include="..\..\cameraunlock-core\csharp\src\CameraUnlock.Core.Unity\CameraUnlock.Core.Unity.csproj">
      <AdditionalProperties>UnityEnginePath=$(MSBuildThisFileDirectory)libs</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>

  <!-- Unity type stubs, built into libs/ by `pixi run setup` from the shared sources -->
  <!-- in cameraunlock-core/csharp/stubs. Referenced, never compiled in: the types must -->
  <!-- resolve to the "UnityEngine" assembly so the game's real one binds at runtime -->
  <ItemGroup>
    <Compile Remove="libs\**" />
    <None Remove="libs\**" />
    <Reference Include="UnityEngine">
      <HintPath>libs\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
